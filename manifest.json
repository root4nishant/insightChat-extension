{
  "manifest_version": 3,
  "name": "WhatsApp AI Insights",
  "version": "1.0",
  "description": "Extract WhatsApp messages and analyze them with AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://insightchat-root.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "bot.png",
      "48": "bot.png",
      "128": "bot.png"
    }
  },
  "icons": {
    "16": "bot.png",
    "48": "bot.png",
    "128": "bot.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://insightchat.rootnishant.in/*"
      ],
      "js": ["token-listener.js"]
    }
  ]
}
